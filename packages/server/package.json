{
	"name": "gsc-language-server",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Language server for Call of Duty GSC (game script).",
	"keywords": [
		"Game Script",
		"Call of Duty",
		"GSC",
		"CoD",
		"LSP",
		"language server"
	],
	"bin": {
		"gsc-language-server": "dist/server.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"bundle": "tsx scripts/build.mts --bundle-only",
		"build": "tsx scripts/build.mts",
		"build:sea": "tsx scripts/sea.mts",
		"typecheck": "tsc -p .",
		"test": "npm run bundle && node --import tsx --test \"test/**/*.test.ts\""
	},
	"devDependencies": {
		"@gsc-language-server/core": "*",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.2",
		"postject": "^1.0.0-alpha.6",
		"vscode-languageserver": "^10.1.2",
		"vscode-languageserver-protocol": "^3.18.4"
	}
}
